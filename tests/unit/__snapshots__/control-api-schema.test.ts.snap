            "type": "object",
            "properties": {
              "type": {
                "const": "prefill_done"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "prefill_viewport": {
          "stable": true,
          "direction": "server-to-client",
          "schema": {
            "$id": "wolfpack:control-api:ws:pty:prefill_viewport",
