        "required": [
          "ok",
          "session",
          "sessionId",
          "matched"
        ],
        "additionalProperties": false
      },
      "errors": [
        "400 ErrorEnvelope",
        "404 ErrorEnvelope",
        "408 ErrorEnvelope",
        "409 ErrorEnvelope",
        "503 ErrorEnvelope"
      ]
    },
