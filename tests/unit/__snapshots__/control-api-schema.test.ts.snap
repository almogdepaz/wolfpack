            "type": "object",
            "properties": {
              "type": {
                "const": "viewer_conflict"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "control_granted": {
          "stable": true,
          "direction": "server-to-client",
          "schema": {
            "$id": "wolfpack:control-api:ws:pty:control_granted",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "/ws/pty control_granted",
            "type": "object",
            "properties": {
              "type": {
                "const": "control_granted"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "sub_session_opened": {
          "stable": true,
          "direction": "server-to-client",
          "schema": {
            "$id": "wolfpack:control-api:ws:pty:sub_session_opened",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "/ws/pty sub_session_opened",
            "type": "object",
            "properties": {
              "type": {
                "const": "sub_session_opened"
              },
              "parentSession": {
                "$ref": "#/$defs/SessionName"
              },
              "session": {
                "$ref": "#/$defs/SessionName"
              }
            },
            "required": [
              "type",
              "parentSession",
              "session"
            ],
            "additionalProperties": false
          }
        }
      },
      "binaryFrames": {
        "client-to-server": "raw PTY input bytes, capped by runtime MAX_PTY_BINARY_BYTES",
        "server-to-client": "raw PTY output/prefill bytes"
      }
    }
  },
  "$defs": {
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": true
    },
    "SessionName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "SessionId": {
      "type": "string",
      "description": "Stable opaque broker session identifier",
      "minLength": 1
    },
    "SessionSelector": {
      "type": "string",
      "description": "Active session name or stable opaque session identifier",
      "minLength": 1
    },
    "SessionPromptSelector": {
      "type": "string",
      "description": "Active session name or stable opaque session identifier for an atomic prompt",
      "minLength": 1,
      "maxLength": 100
    },
    "SessionPromptOutcome": {
      "enum": [
        "matched",
        "timed_out",
        "target_exited",
        "target_unavailable",
        "target_replaced",
        "replay_gap",
        "backend_unavailable"
      ]
    },
    "ProjectName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "Command": {
      "type": "string",
      "minLength": 1
    },
    "BrokerOutputSequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20,
      "description": "Decimal broker PTY output watermark"
    },
    "OpenableHarness": {
      "enum": [
        "pi",
        "claude",
        "codex",
        "gemini",
        "cursor"
      ]
    },
    "TriageStatus": {
      "enum": [
        "running",
        "idle"
      ]
    },
    "AgentStatusState": {
      "enum": [
        "running",
        "working",
        "audit",
        "cleanup",
        "needs-input",
        "done",
        "failed",
        "stopped",
        "output",
        "off",
        "idle",
        "unknown"
      ]
    },
    "AgentStatusAuthority": {
      "enum": [
        "liveness",
        "lifecycle",
        "manifest",
        "fallback",
        "identity"
      ]
    },
    "AgentStatusFreshness": {
      "enum": [
        "fresh",
        "stale",
        "missing",
        "malformed",
        "unknown"
      ]
    },
    "AgentStatusSource": {
      "enum": [
        "broker-liveness",
        "local-manifest",
        "screen-fallback",
        "session-identity"
      ]
    },
    "ParentSessionIdentity": {
      "type": "object",
      "properties": {
        "wolfpackSessionId": {
          "type": "string"
        },
        "wolfpackSessionName": {
          "$ref": "#/$defs/SessionName"
        }
      },
      "required": [
        "wolfpackSessionId",
        "wolfpackSessionName"
      ],
      "additionalProperties": false
    },
    "PublicSessionIdentity": {
      "type": "object",
      "properties": {
        "wolfpackSessionId": {
          "type": "string"
        },
        "wolfpackSessionName": {
          "$ref": "#/$defs/SessionName"
        },
        "projectPath": {
          "type": "string"
        },
        "agentKind": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "restoredAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "parentSession": {
          "$ref": "#/$defs/ParentSessionIdentity"
        },
        "externalAgent": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "redactedId": {
              "type": "string"
            },
            "capturedAt": {
              "type": "string"
            },
            "source": {
              "enum": [
                "env",
                "broker_env"
              ]
            }
          },
          "required": [
            "provider",
            "redactedId",
            "capturedAt",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "wolfpackSessionId",
        "wolfpackSessionName",
        "projectPath",
        "agentKind",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "PrefillMode": {
      "enum": [
        "full",
        "viewport",
        "none"
      ]
    },
    "CmdEntry": {
      "type": "object",
      "properties": {
        "cmd": {
          "$ref": "#/$defs/Command"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "cmd",
        "enabled"
      ],
      "additionalProperties": false
    },
    "Settings": {
      "type": "object",
      "properties": {
        "agentCmd": {
          "type": "string"
        },
        "cmds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CmdEntry"
          }
        }
      },
      "required": [
        "agentCmd",
        "cmds"
      ],
      "additionalProperties": false
    },
    "EffectiveSettings": {
      "type": "object",
      "properties": {
        "agentCmd": {
          "type": "string"
        },
        "cmds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Command"
          }
        }
      },
      "required": [
        "agentCmd",
        "cmds"
      ],
      "additionalProperties": false
    },
    "AgentRuntimeState": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/AgentStatusState"
        },
        "authority": {
          "$ref": "#/$defs/AgentStatusAuthority"
        },
        "freshness": {
          "$ref": "#/$defs/AgentStatusFreshness"
        },
        "source": {
          "$ref": "#/$defs/AgentStatusSource"
        },
        "label": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        },
        "observedAt": {
          "type": "string"
        },
        "changedAt": {
          "type": "string"
        },
        "transitionSequence": {
          "type": "integer"
        },
        "acknowledgedAt": {
          "type": "string"
        },
        "acknowledgedSequence": {
          "type": "integer"
        },
        "unseen": {
          "type": "boolean"
        },
        "runId": {
          "type": "string"
        },
        "runOrder": {
          "type": "number"
        },
        "signalSequence": {
          "type": "number"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "state",
        "authority",
        "freshness",
        "source",
        "label",
        "stale",
        "observedAt",
        "changedAt",
        "transitionSequence",
        "unseen"
      ],
      "additionalProperties": false
    },
    "ProviderReadiness": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/OpenableHarness"
            },
            "displayName": {
              "type": "string"
            },
            "command": {
              "$ref": "#/$defs/Command"
            },
            "status": {
              "const": "installed"
            },
            "executablePath": {
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "authStatus": {
              "const": "unknown"
            },
            "loginCommand": {
