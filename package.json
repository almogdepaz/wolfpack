{
  "name": "wolfpack-bridge",
  "version": "1.6.14",
  "type": "module",
  "description": "Self-hosted browser terminal manager for AI coding agents on your own machines",
  "homepage": "https://github.com/almogdepaz/wolfpack#readme",
  "bugs": {
    "url": "https://github.com/almogdepaz/wolfpack/issues"
  },
  "bin": {
    "wolfpack": "./bin/run.cjs",
    "wolfpack-bridge": "./bin/run.cjs"
  },
  "files": [
    "bin/run.cjs",
    "bin/install.cjs",
    "THIRD_PARTY_NOTICES",
    "llms.txt",
    "docs/agent-skills.md",
    "docs/cli-attach.md",
    "docs/session-control.md",
    "docs/task-gateway.md",
    "skills"
  ],
  "scripts": {
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "gen:schema": "bun run scripts/gen-control-api-schema.ts",
    "perf:terminal-load": "bun scripts/terminal-load-perf.ts",
    "typecheck": "bunx tsc --noEmit -p . && bunx tsc --noEmit -p public/ && bunx tsc --noEmit -p public/tsconfig.strict.json",
    "postinstall": "node bin/install.cjs"
  },
  "optionalDependencies": {
    "wolfpack-bridge-darwin-arm64": "1.6.14",
    "wolfpack-bridge-darwin-x64": "1.6.14",
    "wolfpack-bridge-linux-arm64": "1.6.14",
    "wolfpack-bridge-linux-x64": "1.6.14"
  },
  "keywords": [
    "ai-agent-terminal",
    "ai-agents",
    "ai-coding",
    "agent-orchestration",
    "autonomous-agents",
    "browser-terminal",
    "claude",
    "claude-code",
    "coding-agent",
    "codex",
    "developer-tools",
    "gemini",
    "multi-agent",
    "pwa",
    "remote-development",
    "remote-terminal",
    "self-hosted",
    "tailscale",
    "tailnet",
    "terminal",
    "terminal-dashboard",
    "web-terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/almogdepaz/wolfpack"
  },
  "license": "MIT",
  "dependencies": {
    "ghostty-web": "0.4.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.10",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  }
}
