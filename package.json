{
  "name": "wolfpack-bridge",
  "version": "1.6.19",
  "type": "module",
  "description": "Wolfpack is a self-hosted control room for persistent coding-agent terminals on your own machines.",
  "homepage": "https://almogdepaz.github.io/wolfpack/",
  "bugs": {
    "url": "https://github.com/almogdepaz/wolfpack/issues"
  },
  "bin": {
    "wolfpack": "./bin/run.cjs",
    "wolfpack-bridge": "./bin/run.cjs"
  },
  "files": [
    "bin/run.cjs",
    "bin/install.cjs",
    "THIRD_PARTY_NOTICES",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "llms.txt",
    "docs/README.md",
    "docs/accessibility-testing.md",
    "docs/agent-skills.md",
    "docs/broker-protocol.md",
    "docs/cli-attach.md",
    "docs/control-api-schema.md",
    "docs/generated/control-api.schema.json",
    "docs/installation.md",
    "docs/first-session.md",
    "docs/phone-pwa-notifications.md",
    "docs/assets/wolfpack-desktop-dashboard.png",
    "docs/assets/wolfpack-mobile-sessions.png",
    "docs/live-update-handoff.md",
    "docs/multi-machine-control-room.md",
    "docs/multi-machine-trial-feedback.md",
    "docs/session-control.md",
    "docs/session-identity.md",
    "docs/task-gateway.md",
    "docs/tailnet-release-matrix.md",
    "docs/troubleshooting.md",
    "skills"
  ],
  "scripts": {
    "test": "bun test",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "gen:schema": "bun run scripts/gen-control-api-schema.ts",
    "perf:terminal-load": "bun scripts/terminal-load-perf.ts",
    "typecheck": "bunx tsc --noEmit -p . && bunx tsc --noEmit -p public/ && bunx tsc --noEmit -p public/tsconfig.strict.json",
    "postinstall": "node bin/install.cjs",
    "check:bundle-budgets": "bun run scripts/check-bundle-budgets.ts",
    "smoke:release": "bun run scripts/smoke-release-artifacts.ts"
  },
  "optionalDependencies": {
    "wolfpack-bridge-darwin-arm64": "1.6.19",
    "wolfpack-bridge-darwin-x64": "1.6.19",
    "wolfpack-bridge-linux-arm64": "1.6.19",
    "wolfpack-bridge-linux-x64": "1.6.19"
  },
  "keywords": [
    "ai-agent-terminal",
    "ai-agents",
    "ai-coding",
    "agent-orchestration",
    "autonomous-agents",
    "browser-terminal",
    "coding-agent",
    "developer-tools",
    "multi-agent",
    "pwa",
    "remote-development",
    "remote-terminal",
    "self-hosted",
    "tailscale",
    "tailnet",
    "terminal",
    "terminal-dashboard",
    "web-terminal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/almogdepaz/wolfpack"
  },
  "license": "MIT",
  "dependencies": {
    "ghostty-web": "0.4.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.58.2",
    "@types/ws": "^8.18.1",
    "@xmldom/xmldom": "^0.9.11",
    "bun-types": "^1.3.10",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  }
}
