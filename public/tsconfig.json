{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Legacy browser modules still have broad implicit-any/null debt. Keep this
    // compatibility check non-strict while tsconfig.strict.json enforces strict
    // coverage for migrated modules; add modules there as they are typed.
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": ["**/*.ts"]
}
